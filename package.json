{
  "name": "character-unity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap-foundry.mjs && pnpm install --frozen-lockfile",
    "dev": "pnpm --parallel --filter @character-unity/api-host --filter @character-unity/web run dev",
    "dev:web": "pnpm --filter @character-unity/web dev",
    "dev:architect": "pnpm --filter @character-unity/architect dev",
    "dev:hub": "pnpm --filter @character-unity/hub dev",
    "dev:api": "pnpm --filter @character-unity/api-host dev",
    "accounts": "pnpm --filter @character-unity/api-host accounts",
    "assets": "pnpm --filter @character-unity/api-host assets",
    "dev:archive": "pnpm --filter @character-unity/archive dev",
    "archive:index": "pnpm --filter @character-unity/archive index",
    "dev:worker": "pnpm --filter @character-unity/api-host dev:worker",
    "build": "pnpm -r --if-present run build",
    "build:worker": "pnpm --filter @character-unity/api-host build:worker",
    "worker:types": "pnpm --filter @character-unity/api-host worker:types",
    "lint": "eslint .",
    "type-check": "pnpm worker:types && pnpm -r --if-present run type-check && pnpm type-check:e2e",
    "test": "vitest run --reporter=default --reporter=json --outputFile=runtime/test-results.json && node scripts/conformance-coverage.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:container": "node scripts/verify-container.mjs",
    "verify:sillytavern": "node scripts/verify-sillytavern.mjs",
    "verify:foundry": "node scripts/verify-foundry.mjs",
    "check": "node scripts/assert-foundry.mjs && pnpm verify:foundry ../.unity-foundry-sdk/packages/character-foundry && pnpm verify:sync ../.unity-foundry-sdk/packages/character-foundry && pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm verify:archive-native && pnpm build:browser && pnpm build:worker && pnpm smoke && pnpm verify:worker && pnpm build:e2e && pnpm test:e2e && pnpm test:e2e:unity && node scripts/verify-e2e-archive.mjs",
    "test:e2e": "playwright test",
    "test:e2e:unity": "pnpm --filter @character-unity/web build && playwright test --config playwright.unity.config.ts",
    "type-check:e2e": "tsc -p e2e/tsconfig.json",
    "build:browser": "pnpm --filter @character-unity/architect build:browser",
    "dev:browser": "pnpm --filter @character-unity/architect dev:browser",
    "build:e2e": "pnpm --filter @character-unity/archive build:e2e && pnpm --filter @character-unity/architect build:browser:test",
    "verify:worker": "node scripts/verify-worker.mjs",
    "verify:sync": "node scripts/verify-sync.mjs",
    "peers": "pnpm --filter @character-unity/api-host peers",
    "verify:archive-native": "node scripts/verify-archive-native.mjs",
    "verify:archive-container": "node scripts/verify-archive-container.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
