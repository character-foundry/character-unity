{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "character-unity-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "UNITY_PUBLIC_ORIGIN": "http://127.0.0.1:9312",
    "UNITY_ARCHIVE_ORIGIN": "",
    "UNITY_SYNC_ENABLED": "false",
    "UNITY_SYNC_WRITES_ENABLED": "false",
    "UNITY_REMOTE_CONNECTIONS_JSON": "{\"version\":\"unity.remote-connections.v1\",\"connections\":[]}"
  },
  "d1_databases": [
    {
      "binding": "UNITY_DB",
      "database_name": "unity-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UNITY_BLOBS",
      "bucket_name": "unity-local"
    }
  ],
  "ratelimits": [
    {
      "name": "UNITY_LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "UNITY_SYNC_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
